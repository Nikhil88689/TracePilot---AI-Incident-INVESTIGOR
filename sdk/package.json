{
  "name": "@tracepilot/node",
  "version": "0.1.0",
  "description": "Minimal Node.js SDK for sending errors to TracePilot",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18.17" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^24"
  }
}
