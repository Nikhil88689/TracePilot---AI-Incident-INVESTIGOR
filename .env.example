# TracePilot environment variables. Copy to .env.local for development (never commit .env.local).
# On Vercel add the same names under Project -> Settings -> Environment Variables (see README
# "Deploy to Vercel"). Every value below is a PLACEHOLDER; the app never needs a database password
# or connection string (it talks to Supabase over HTTPS, so there is no connection pool to configure).

# --- Supabase (Dashboard -> Project Settings -> API Keys) --------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co            [public, required]
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The *publishable* key (sb_publishable_...). Safe for the browser; protected by Row Level Security.
# [public, required]. Older projects can use the legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY with the
# "anon" JWT instead; the app accepts either (the publishable name wins if both are set).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# The *secret* / service_role key. BYPASSES Row Level Security. [SERVER-ONLY, required for ingestion]
# Used only by POST /api/v1/events (API-key authenticated, no user session). Never prefix it with
# NEXT_PUBLIC_, never paste it into client code, and rotate it if it is ever exposed. Without it the
# ingestion endpoint answers 503 and the rest of the app still works.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY

# --- App origin ---------------------------------------------------------------------------------------
# Public origin of this deployment, no trailing slash. Used in auth email links, the ingestion URL shown
# in onboarding, and by "Send test event" (which POSTs to <this>/api/v1/events).
# Local:       http://localhost:3000
# Production:  set it to your production URL (e.g. https://tracepilot.vercel.app or your custom domain).
# Preview:     LEAVE UNSET for the Preview environment: the app then uses Vercel's per-deployment URL
#              (VERCEL_URL), so confirmation emails from a preview link back to that preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI investigation (server-only, optional) ---------------------------------------------------------
# Read only inside POST /api/v1/incidents/[id]/analyze; never reaches the browser. Leave it empty or unset
# and the app still works: the demo, the sample investigation and everything else run, and "Investigate
# with AI" shows a clear "not configured" message instead of failing.
ANTHROPIC_API_KEY=
# Any model id the Anthropic API accepts. An unknown id surfaces as a clear error, not a crash.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Ceiling for one provider call in ms, clamped to 1000-55000 so it always fits the route's 60 s maxDuration.
AI_TIMEOUT_MS=30000

# --- Provided by Vercel automatically (do not set) ----------------------------------------------------
# VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL are read to pick the right site URL.

# --- Tests only (never set on Vercel) -----------------------------------------------------------------
# E2E_BASE_URL, E2E_EMAIL, E2E_PASSWORD   Playwright against a running server with a confirmed throwaway user
# `npm run test:rls` reads this file for NEXT_PUBLIC_SUPABASE_URL, the publishable key and the service-role key.
