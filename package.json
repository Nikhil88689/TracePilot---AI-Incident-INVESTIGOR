    "test:rls": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "test:e2e:local": "node scripts/local-e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
